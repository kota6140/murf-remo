# Agent Hari — Environment Configuration Example
PORT=8080
NODE_ENV=development

# JWT Authentication Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Database Configuration (MySQL / SQLite fallback)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=agent_hari

# Email Delivery Configuration (For Password Reset)
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.takeremo.com
EMAIL_PORT=587
EMAIL_USER=Reach@takeremo.com
EMAIL_PASSWORD=your_email_password
RESET_URL=http://localhost:8080/reset-password

# ==========================================
# Plivo Telephony Gateway
# ==========================================
# 1. Plivo Auth ID and Token (from https://console.plivo.com)
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here

# 2. Plivo Purchased Virtual Number (e.g. 9180XXXXXXXX or +1XXXXXXXXXX)
PLIVO_VIRTUAL_NUMBER=9180XXXXXXXX

# 3. Public Server Base URL for Plivo callbacks and WebSocket stream
SERVER_URL=https://takeremo.com

# ==========================================
# ElevenLabs Voice AI Pipeline
# ==========================================
# 1. ElevenLabs API Key (from https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 2. Chosen Voice ID (e.g., Kanika or custom cloned voice)
ELEVENLABS_VOICE_ID=your_voice_id_here

# 3. Multilingual Speech Model (eleven_multilingual_v2 or eleven_turbo_v2_5)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# 4. Webhook Signing Secret (wsec_... from ElevenLabs Developers > Webhooks)
ELEVENLABS_WEBHOOK_SECRET=your_webhook_secret_here

# 5. Optional Timeouts & Performance Tuning
ELEVENLABS_TTS_TIMEOUT_MS=4500
ELEVENLABS_STT_TIMEOUT_MS=4500

# ==========================================
# LLM Intelligence (Google Gemini)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_TIMEOUT_MS=3800


# ==========================================
# Owner Admin Panel (/admin)
# ==========================================
ADMIN_EMAIL=admin@takeremo.com
ADMIN_PASSWORD=change-me
