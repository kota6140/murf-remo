# Agent Hari — Environment Configuration Example
PORT=8080
NODE_ENV=development

# JWT Authentication Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Database Configuration (For future database switch)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=agent_hari

# Email Delivery Configuration (For Password Reset)
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.takeremo.com
EMAIL_PORT=587
EMAIL_USER=Reach@takeremo.com
EMAIL_PASSWORD=your_email_password
RESET_URL=http://localhost:8080/reset-password

# ==========================================
# Voice AI Pipeline API Keys (Future Phases)
# ==========================================

# 1. Telephony Gateway (Exotel)
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_SUBDOMAIN=your_exotel_subdomain_here
EXOTEL_VIRTUAL_NUMBER=080XXXXXXX

# 2. Speech-to-Text / STT (Sarvam AI provides this)
SARVAM_API_KEY=your_sarvam_api_key_here
# DEEPGRAM_API_KEY=your_deepgram_api_key_here (Optional Alternative)

# 3. Large Language Model / LLM (e.g., OpenAI, Gemini)
OPENAI_API_KEY=your_openai_api_key_here


# 4. Text-to-Speech / TTS (Sarvam AI provides this too)
# Note: You can reuse the SARVAM_API_KEY for TTS
SARVAM_VOICE_ID=your_chosen_sarvam_voice_id_here
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here (Optional Alternative)
# ELEVENLABS_VOICE_ID=your_chosen_voice_id_here

# Owner admin panel (/admin)
ADMIN_EMAIL=admin@takeremo.com
ADMIN_PASSWORD=change-me
